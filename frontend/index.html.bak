<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CRM UCM6202</title><style>
*{box-sizing:border-box}body{margin:0;font-family:Tahoma,Arial,sans-serif;background:#f4f7fb;color:#172033}.top{padding:18px 26px;background:#101828;color:#fff;display:flex;justify-content:space-between;align-items:center}.top h1{margin:0;font-size:22px}.wrap{padding:24px;max-width:1400px;margin:auto}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.card{background:#fff;border-radius:16px;padding:18px;box-shadow:0 5px 20px #0000000b}.num{font-size:30px;font-weight:700;margin-top:8px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0}.tabs button,.btn{border:0;border-radius:10px;padding:10px 14px;cursor:pointer;background:#e7eef8}.tabs button.active,.btn.primary{background:#101828;color:#fff}.panel{background:#fff;border-radius:16px;padding:18px;box-shadow:0 5px 20px #0000000b;margin-top:15px}.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}.toolbar input{padding:11px;border:1px solid #d7dee9;border-radius:9px;min-width:260px}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:11px;border-bottom:1px solid #eef1f5;text-align:right;font-size:13px}.pill{padding:5px 9px;border-radius:999px;background:#edf2f7;display:inline-block}.danger{background:#fff0f0;color:#b42318}.ok{background:#edfdf3;color:#027a48}.rowlink{cursor:pointer;color:#155eef}.empty{padding:25px;text-align:center;color:#667085}.modal{display:none;position:fixed;inset:0;background:#0007;align-items:center;justify-content:center}.modal.show{display:flex}.modalbox{background:white;border-radius:18px;padding:25px;width:min(900px,94vw);max-height:90vh;overflow:auto}.close{float:left;cursor:pointer;font-size:25px}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}.wrap{padding:12px}.table{font-size:12px}}
</style></head><body><header class="top"><h1>CRM تلفنی Grandstream UCM6202</h1><span id="status">در حال اتصال...</span></header><main class="wrap">
<section class="grid"><div class="card">مخاطبین<div class="num" id="contacts">-</div></div><div class="card">کل تماس‌ها<div class="num" id="total">-</div></div><div class="card">تماس ورودی<div class="num" id="inbound">-</div></div><div class="card">تماس خروجی<div class="num" id="outbound">-</div></div><div class="card">از دست‌رفته<div class="num" id="missed">-</div></div></section>
<div class="tabs"><button class="active" onclick="showTab('dashboard',this)">داشبورد</button><button onclick="showTab('cdr',this)">CDR</button><button onclick="showTab('contactsTab',this)">مخاطبین</button><button onclick="syncNow()">همگام‌سازی UCM</button></div>
<section id="dashboard" class="panel"><h2>تماس‌های اخیر</h2><p style="color:#667085">همگام‌سازی خودکار هر 60 ثانیه انجام می‌شود. برای دریافت فوری، «همگام‌سازی UCM» را بزنید.</p><div id="recent"></div></section>
<section id="cdr" class="panel" style="display:none"><div class="toolbar"><input id="search" placeholder="جستجوی شماره یا نام..." oninput="loadCdr()"><button class="btn" onclick="loadCdr()">بروزرسانی</button></div><div id="cdrTable"></div></section>
<section id="contactsTab" class="panel" style="display:none"><div class="toolbar"><input id="contactSearch" placeholder="جستجوی مخاطب..." oninput="loadContacts()"><button class="btn primary" onclick="newContact()">مخاطب جدید</button></div><div id="contactsTable"></div></section>
</main><div id="modal" class="modal"><div class="modalbox"><span class="close" onclick="closeModal()">×</span><div id="modalContent"></div></div></div>
<script>
const $=id=>document.getElementById(id); async function api(path,opt){let r=await fetch(path,opt); if(!r.ok) throw new Error(await r.text()); return r.json()}
function fmtDirection(d){return d==='inbound'?'ورودی':d==='outbound'?'خروجی':'داخلی'}
function table(rows){if(!rows.length)return '<div class="empty">اطلاعاتی وجود ندارد</div>'; return `<table class="table"><tr><th>زمان</th><th>مشتری</th><th>شماره</th><th>نوع</th><th>داخلی</th><th>وضعیت</th><th>مدت</th><th>Recording</th></tr>${rows.map(x=>{let phone=x.direction==='inbound'?x.caller:(x.direction==='outbound'?x.callee:(x.caller||x.callee));return `<tr><td>${x.start_time||'-'}</td><td class="rowlink" onclick="openCustomer('${String(phone||'').replace(/'/g,"\\'")}')">${x.customer||x.caller_name||'-'}</td><td>${phone||'-'}</td><td><span class="pill">${fmtDirection(x.direction)}</span></td><td>${x.answer_by||'-'}</td><td><span class="pill ${x.disposition&&x.disposition.toLowerCase().includes('answer')?'ok':'danger'}">${x.disposition||'-'}</span></td><td>${x.talk_time||x.call_time||'-'}</td><td>${x.recordfiles?'<button class="btn" onclick="alert(\'Recording: '+String(x.recordfiles).replace(/'/g,"\\'")+'\')">▶</button>':'-'}</td></tr>`}).join('')}</table>`}
async function load(){try{let d=await api('/api/dashboard'); Object.entries(d.stats).forEach(([k,v])=>$(k).textContent=v); $('recent').innerHTML=table(d.recent); $('status').textContent='متصل';}catch(e){$('status').textContent='خطا در اتصال به UCM/Backend'}}
async function loadCdr(){try{$('cdrTable').innerHTML=table(await api('/api/cdr?limit=200&search='+encodeURIComponent($('search').value)))}catch(e){$('cdrTable').innerHTML='<div class="empty">خطا در دریافت CDR</div>'}}
async function loadContacts(){let r=await api('/api/contacts?search='+encodeURIComponent($('contactSearch').value));$('contactsTable').innerHTML=r.length?`<table class="table"><tr><th>نام</th><th>شماره</th><th>شرکت</th><th>سوابق</th></tr>${r.map(x=>`<tr><td>${x.name}</td><td>${x.phone}</td><td>${x.company||'-'}</td><td><button class="btn" onclick="openCustomer('${x.phone}')">مشاهده</button></td></tr>`).join('')}</table>`:'<div class="empty">مخاطبی ثبت نشده</div>'}
async function openCustomer(phone){let r=await api('/api/customer/'+encodeURIComponent(phone));let c=r.contact; $('modalContent').innerHTML=`<h2>${c?c.name:phone}</h2><p>شماره: ${phone} ${c&&c.company?' | شرکت: '+c.company:''}</p><h3>تاریخچه تماس</h3>${table(r.calls)}`;$('modal').classList.add('show')}
function closeModal(){$('modal').classList.remove('show')}
async function syncNow(){ $('status').textContent='در حال همگام‌سازی...'; try{await api('/api/sync',{method:'POST'});await load();await loadCdr();$('status').textContent='همگام شد'}catch(e){$('status').textContent='خطای Sync'}}
function showTab(id,b){['dashboard','cdr','contactsTab'].forEach(x=>$(x).style.display=x===id?'block':'none');document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');if(id==='cdr')loadCdr();if(id==='contactsTab')loadContacts()}
function newContact(){let n=prompt('نام مشتری:');if(!n)return;let p=prompt('شماره:');if(!p)return;fetch('/api/contacts',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:n,phone:p})}).then(()=>loadContacts())}
function playRec(v){alert('Recording در نسخه اول از API گران‌استریم گرفته می‌شود. recordfiles خام: '+v)}
load();setInterval(load,30000)
</script></body></html>
